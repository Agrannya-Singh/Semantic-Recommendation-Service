# ==============================================================================
# ScreenScout Semantic Recommendation Engine - Environment Variables Configuration
# ==============================================================================

# --- Primary Google Gemini API Key ---
# Required for Google Gemini 3 Flash / LLM-as-a-Judge and RAG reasoning pipeline
GOOGLE_API_KEY="AIzaSyYourActualGoogleGeminiApiKeyHere"

# --- Pinecone Vector Database Key ---
# Required for Approximate Nearest Neighbor (ANN) vector similarity search (384 dimensions)
PINECONE_KEY="your-pinecone-api-key-here"

# --- OMDB API Key (Optional) ---
# Used for enriching recommendation cards with live IMDb ratings, posters, and release years
OMDB_API_KEY="your_omdb_api_key_here"

# --- Cloud Firestore Project ID (Optional) ---
# Set if you wish to persist audit results to Google Cloud Firestore (llm_judge_audits collection)
FIRESTORE_PROJECT_ID="your-gcp-project-id"

# --- Server Port (Deployment) ---
PORT=8000
